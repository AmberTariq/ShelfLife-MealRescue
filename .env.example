# VITE_GEMINI_API_KEY: Gemini API key used directly in the browser via @google/genai.
# Required for fridge photo analysis and meal triage. Vite inlines it at build time,
# so set it in your Netlify environment variables (or a local .env file) before building.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
